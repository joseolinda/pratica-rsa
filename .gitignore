# Versionar apenas o material da prática e os arquivos de troca previstos.
*
!/*.MD
!/README.html
!/README-Powershell.html
!/index.html
!/.gitignore
!/.gitattributes

!/public-keys/
!/public-keys/.gitkeep
!/public-keys/*.pub

!/messages/
!/messages/**/
!/messages/.gitkeep
!/messages/**/mensagem.txt
!/messages/**/assinatura.bin

!/responses/
!/responses/**/
!/responses/.gitkeep
!/responses/**/resposta.enc

# Manter dados locais e chaves privadas fora do Git, inclusive em subpastas.
/local/
private.key
*.key
*.pem
